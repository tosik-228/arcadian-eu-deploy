# No credentials belong in Git. Production uses App Platform secret variables.
DJANGO_ENV=production
CMS_URL=https://cms.arcadian-eu.com
CMS_ALLOWED_HOSTS=cms.arcadian-eu.com,REPLACE_DEFAULT_APP_HOST
CMS_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
SITE_ORIGINS=https://arcadian-eu.com,https://www.arcadian-eu.com
DB_NAME=arcadian_content
DB_USER=arcadian_runtime
DB_PASSWORD=REPLACE
DB_HOST=REPLACE_MANAGED_POSTGRES_HOST
DB_PORT=25060
DB_CA_PEM=REPLACE_WITH_MANAGED_POSTGRES_CA
S3_BUCKET=REPLACE_PRIVATE_MEDIA_BUCKET
S3_REGION=fra1
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_ACCESS_KEY=REPLACE_BUCKET_SCOPED_KEY
S3_SECRET_KEY=REPLACE
BACKUP_AGE_RECIPIENT=REPLACE_PUBLIC_AGE_RECIPIENT
BACKUP_S3_BUCKET=REPLACE_SEPARATE_BACKUP_BUCKET
BACKUP_S3_REGION=ams3
BACKUP_S3_ENDPOINT=https://ams3.digitaloceanspaces.com
BACKUP_S3_ACCESS_KEY=REPLACE_SEPARATE_BACKUP_WRITE_KEY
BACKUP_S3_SECRET_KEY=REPLACE
MIGRATION_DB_USER=REPLACE_DB_OWNER
MIGRATION_DB_PASSWORD=REPLACE
RUNTIME_DB_USER=arcadian_runtime
RUNTIME_DB_PASSWORD=REPLACE_24_RANDOM_CHARACTERS
BACKUP_DB_USER=arcadian_backup
BACKUP_DB_PASSWORD=REPLACE_24_RANDOM_CHARACTERS
S3_BACKUP_READ_ACCESS_KEY=REPLACE_MEDIA_READ_ONLY_KEY
S3_BACKUP_READ_SECRET_KEY=REPLACE
